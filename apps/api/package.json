{
  "name": "@forge/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:prepare": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://forge:forge@localhost:5432/forge_test} prisma migrate deploy --schema ../../packages/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@forge/db": "workspace:*",
    "@forge/shared": "workspace:*",
    "argon2": "^0.41.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.0",
    "@types/supertest": "^6.0.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
