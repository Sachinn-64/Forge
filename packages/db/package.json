    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "dotenv-cli": "^7.4.0",
    "prisma": "^6.0.0",
    "typescript": "^5.6.0"
  }
}
